diff --git a/src/main/java/cam72cam/immersiverailroading/entity/physics/Simulation.java b/src/main/java/cam72cam/immersiverailroading/entity/physics/Simulation.java
index af7183e7..4b94c6d2 100644
--- a/src/main/java/cam72cam/immersiverailroading/entity/physics/Simulation.java
+++ b/src/main/java/cam72cam/immersiverailroading/entity/physics/Simulation.java
@@ -13,11 +13,35 @@ import cam72cam.mod.math.Vec3i;
 import cam72cam.mod.world.World;
 
 import java.util.*;
+import java.util.concurrent.ConcurrentLinkedQueue;
 import java.util.stream.Collectors;
 
 public class Simulation {
 
     public static volatile boolean forceQuickUpdates = false;
+    private static final Queue<DirtyRequest> dirtyRequests = new ConcurrentLinkedQueue<>();
+
+    private record DirtyRequest(World world, Vec3d center, double range) {}
+
+    /** Any thread; applied on the next simulate() of the world */
+    public static void markDirtyNear(World world, Vec3d center, double range) {
+        dirtyRequests.add(new DirtyRequest(world, center, range));
+        forceQuickUpdates = true;
+    }
+
+    private static void applyDirtyRequests(World world) {
+        dirtyRequests.removeIf(request -> {
+            if (request.world != world) {
+                return false;
+            }
+            for (EntityCoupleableRollingStock stock : world.getEntities(EntityCoupleableRollingStock.class)) {
+                if (stock.getPosition().distanceTo(request.center) < request.range) {
+                    stock.states.forEach(state -> state.dirty = true);
+                }
+            }
+            return true;
+        });
+    }
     public static int calculatedStates;
     public static int restStates;
     public static int keptStates;
@@ -377,6 +401,7 @@ public class Simulation {
             forceQuickUpdates = false;
         }
 
+        applyDirtyRequests(world);
         new Simulation(world);
     }
 
